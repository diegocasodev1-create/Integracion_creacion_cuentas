{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "integracion-cuentas",
  "main": "src/index.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./public/",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    { "binding": "RESELLER_KV", "id": "c5e1aec370654e879f7b4e4c79dd5aef" }
  ],
  "observability": {
    "enabled": true
  }
}
